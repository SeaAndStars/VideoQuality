<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="coverlet.msbuild" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VideoQuality.Core\VideoQuality.Core.csproj" />
    <!-- Built first and copied beside the tests as FakeTool/ (see FakeTools.cs). -->
    <ProjectReference Include="..\VideoQuality.Tests.FakeTool\VideoQuality.Tests.FakeTool.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyFakeTool" AfterTargets="Build">
    <ItemGroup>
      <FakeToolFiles Include="$(MSBuildThisFileDirectory)..\VideoQuality.Tests.FakeTool\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FakeToolFiles)" DestinationFolder="$(OutDir)FakeTool\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
