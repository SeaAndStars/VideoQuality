<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />
    <!-- Native HarfBuzz (MIT) for font subsetting; the same library Avalonia already ships. -->
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.3" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="8.3.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI text catalogs, one flat key → text map per language (see Localization/Loc.cs). -->
    <EmbeddedResource Include="Localization\*.json" LogicalName="VideoQuality.Core.Localization.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VideoQuality.Tests" />
  </ItemGroup>

</Project>
