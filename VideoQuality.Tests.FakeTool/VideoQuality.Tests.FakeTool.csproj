<Project Sdk="Microsoft.NET.Sdk">

  <!-- A scripted stand-in for ffmpeg, mkvmerge, nvidia-smi, … so process code, failure paths and the
       CUDA paths are tested without the real tools or a GPU. See Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
