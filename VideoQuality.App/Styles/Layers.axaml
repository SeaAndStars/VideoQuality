<!--
    The layer model. Every container picks one class; nothing sets its own background colour.

      base     window background                      SemiColorBackground0
      surface  cards: viewer panes, graph, table       SemiColorBackground1 + 1 px border
      raised   toolbar, floating legends, chips        SemiColorBackground2 + shadow
      overlay  drop zones, dialogs, toasts             scrim + zone cards
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="https://irihi.tech/ursa"
        xmlns:ic="using:FluentIcons.Avalonia">

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}" />
    </Style>

    <Style Selector="Border.surface">
        <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource VqRadiusCard}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.raised">
        <Setter Property="Background" Value="{DynamicResource SemiColorBackground2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource VqRadiusCard}" />
        <Setter Property="BoxShadow" Value="{StaticResource VqRaisedShadow}" />
    </Style>

    <!-- Floating label over video: raised, translucent, small. -->
    <Style Selector="Border.float">
        <Setter Property="Background" Value="#CC1C1D21" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource VqRadiusControl}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="12" />
    </Style>

    <!-- Tool pages: header card, section titles, list rows, drop highlight. -->
    <Style Selector="TextBlock.pagetitle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
    </Style>
    <Style Selector="TextBlock.pagesub">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </Style>
    <Style Selector="Border.pageicon">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
    </Style>
    <Style Selector="Border.pageicon ic|SymbolIcon">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
    </Style>
    <Style Selector="Border.row">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="{StaticResource VqRadiusControl}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.row:pointerover">
        <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
    </Style>
    <Style Selector="Border.dropglow">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="{StaticResource VqRadiusCard}" />
        <Setter Property="Background" Value="#1A54A9FF" />
        <Setter Property="Margin" Value="8" />
    </Style>
    <Style Selector="UserControl.dragging Border.dropglow">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- The page's main action: Semi's solid button (primary colour by default). -->
    <Style Selector="Button.primary">
        <Setter Property="Theme" Value="{DynamicResource SolidButton}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="16,4" />
        <Setter Property="CornerRadius" Value="{StaticResource VqRadiusControl}" />
    </Style>

    <!-- Navigation rail: the base layer, separated from the pages by a hairline. -->
    <Style Selector="Border.rail">
        <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="u|NavMenu.rail">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="4,4" />
    </Style>

    <Style Selector="Border.canvas">
        <Setter Property="Background" Value="{StaticResource VqCanvasBrush}" />
    </Style>

    <!-- Section labels: small caps style used in pane headers and table headers. -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.6" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Cascadia Mono, JetBrains Mono, DejaVu Sans Mono, monospace" />
    </Style>

    <!-- Chips: pill-shaped status tags (badges, backend, model). -->
    <Style Selector="Border.chip">
        <Setter Property="Height" Value="22" />
        <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource VqRadiusChip}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip ic|SymbolIcon">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip.warn">
        <Setter Property="Background" Value="{StaticResource VqWarnSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VqWarnBrush}" />
    </Style>
    <Style Selector="Border.chip.warn TextBlock">
        <Setter Property="Foreground" Value="{StaticResource VqWarnBrush}" />
    </Style>
    <Style Selector="Border.chip.warn ic|SymbolIcon">
        <Setter Property="Foreground" Value="{StaticResource VqWarnBrush}" />
    </Style>
    <Style Selector="Border.chip.accent">
        <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" />
    </Style>
    <Style Selector="Border.chip.accent TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
    </Style>
    <Style Selector="Border.chip.accent ic|SymbolIcon">
        <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
    </Style>

    <!-- Toolbar buttons: borderless icon buttons with a consistent hit target. -->
    <Style Selector="u|IconButton.tool">
        <Setter Property="Theme" Value="{DynamicResource BorderlessIconButton}" />
    </Style>
    <Style Selector="Button.tool">
        <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
    </Style>
    <Style Selector="u|IconButton.tool, Button.tool">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="{StaticResource VqRadiusControl}" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
    </Style>
    <Style Selector="u|IconToggleButton.tool">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="{StaticResource VqRadiusControl}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
    </Style>
    <Style Selector="u|IconToggleButton.tool:pointerover">
        <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
    </Style>
    <Style Selector="u|IconToggleButton.tool:checked">
        <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
    </Style>
    <!-- Toolbar row: every control is 32 px tall so icons, text and boxes share one centre line. -->
    <Style Selector="Border.toolbar ComboBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.toolbar Slider">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Card header: one height for every card so neighbouring headers line up. -->
    <Style Selector="Grid.cardheader">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Section heading inside flyouts and dialogs. -->
    <!-- Empty states: an icon over a short hint, centred in the card. -->
    <Style Selector="StackPanel.empty">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="MaxWidth" Value="420" />
    </Style>
    <Style Selector="StackPanel.empty > ic|SymbolIcon">
        <Setter Property="FontSize" Value="36" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </Style>
    <Style Selector="StackPanel.empty > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- Motion: a page fades and rises into place when it is shown; new rows fade in; state changes ease. -->
    <Style Selector="Panel.pages > UserControl">
        <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>
    <Style Selector="Panel.pages > UserControl[IsVisible=True]">
        <Style.Animations>
            <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="10" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="ItemsControl.reveal > ContentPresenter, ListBox.encodes > ListBoxItem">
        <Setter Property="RenderTransform" Value="translateY(0px)" />
        <Style.Animations>
            <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="6" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.step > Grid > :is(Control)">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.row">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Forms: a label column and a field column. Labels sit on their field's centre line at the body size. -->
    <!-- Rows are spaced by the children's margins, not RowSpacing, so a hidden row takes no space at all. -->
    <Style Selector="Grid.form">
        <Setter Property="ColumnSpacing" Value="10" />
    </Style>
    <Style Selector="Grid.form > :is(Control)">
        <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style Selector="Grid.form > Grid.cardheader">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Grid.form > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.form NumericUpDown, Grid.form ComboBox, Grid.form TextBox">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Grid.form > TextBlock.hint">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </Style>

    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.6" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText1}" />
    </Style>

    <!-- Tooltips float on the raised layer, dark like everything else. -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SemiColorBackground3}" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource VqRadiusControl}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <Style Selector="ic|SymbolIcon">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Row status: a solid disc with a small glyph centred inside, or an empty ring when queued. -->
    <Style Selector="Border.statusdot">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.statusdot ic|SymbolIcon">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Ellipse.statusring">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Stroke" Value="{DynamicResource SemiColorText3}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeDashArray" Value="2,2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Segmented view switch (Ursa SelectionList). -->
    <Style Selector="Border.segmented">
        <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        <Setter Property="CornerRadius" Value="{StaticResource VqRadiusControl}" />
        <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="u|SelectionList.segmented">
        <!-- The theme's minimum height made the group 50 px tall; 28 + the border's 2 px inset = 32. -->
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="u|SelectionList.segmented u|SelectionListItem">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Encode table rows: hover actions fade in, the tiny ✕ is gone. -->
    <Style Selector="ListBox.encodes ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="{StaticResource VqRadiusControl}" />
    </Style>
    <Style Selector="ListBox.encodes ListBoxItem StackPanel.actions">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBox.encodes ListBoxItem:pointerover StackPanel.actions, ListBox.encodes ListBoxItem:selected StackPanel.actions">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.rowaction">
        <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.rowaction ic|SymbolIcon">
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Overlay: fades in over 120 ms; zones are dashed cards that light up under the pointer. -->
    <Style Selector="Panel.overlay">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Panel.overlay.visible">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <Style Selector="Border.zone">
        <Setter Property="Background" Value="{StaticResource VqZoneBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource VqRadiusCard}" />
        <Setter Property="BoxShadow" Value="{StaticResource VqOverlayShadow}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.zone.hot">
        <Setter Property="Background" Value="{StaticResource VqZoneHotBrush}" />
    </Style>
    <Style Selector="Border.zone Rectangle.dash">
        <Setter Property="Stroke" Value="{DynamicResource SemiColorText3}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeDashArray" Value="6,4" />
        <Setter Property="RadiusX" Value="10" />
        <Setter Property="RadiusY" Value="10" />
        <Setter Property="Margin" Value="-12" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.zone.hot Rectangle.dash">
        <Setter Property="Stroke" Value="{DynamicResource SemiColorPrimary}" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>
    <Style Selector="Border.zone ic|SymbolIcon.zoneicon">
        <Setter Property="FontSize" Value="36" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText1}" />
    </Style>
    <Style Selector="Border.zone.hot ic|SymbolIcon.zoneicon">
        <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
    </Style>

    <!-- Viewer/graph splitter: a visible grip in the gap, highlighted on hover and while dragging. -->
    <Style Selector="GridSplitter.viewer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="8" />
        <Setter Property="ResizeDirection" Value="Rows" />
        <Setter Property="Cursor" Value="SizeNorthSouth" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                    <Border x:Name="PART_Grip" Width="48" Height="4" CornerRadius="2"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource SemiColorFill2}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="GridSplitter.viewer:pointerover">
        <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
    </Style>
    <Style Selector="GridSplitter.viewer:pointerover /template/ Border#PART_Grip, GridSplitter.viewer:pressed /template/ Border#PART_Grip">
        <Setter Property="Background" Value="{DynamicResource SemiColorPrimary}" />
    </Style>
</Styles>
