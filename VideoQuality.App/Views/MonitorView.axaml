<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:VideoQuality.App.Localization"
             xmlns:vm="using:VideoQuality.App.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:controls="using:VideoQuality.App.Controls"
             x:Class="VideoQuality.App.Views.MonitorView"
             x:DataType="vm:MonitorViewModel">
    <UserControl.DataTemplates>
        <DataTemplate x:DataType="vm:Gauge">
            <Border Classes="surface" Padding="12">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="label" Text="{Binding Title}" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" />
                    </Grid>
                    <controls:Sparkline Grid.Row="1" Values="{Binding History}" MinHeight="70" Stroke="{DynamicResource SemiColorPrimary}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Margin="12">
        <Border Classes="raised" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Classes="pageicon"><ic:SymbolIcon Symbol="Pulse" /></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="pagetitle" Text="{l:L nav.monitor}" />
                    <TextBlock Classes="pagesub" Text="{l:L monitor.processorMemoryAndNvidia}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <UniformGrid Columns="2" RowSpacing="12" ColumnSpacing="12">
                    <ContentControl Content="{Binding Cpu}" />
                    <ContentControl Content="{Binding Memory}" />
                </UniformGrid>
                <TextBlock Classes="label" Text="{Binding GpuName}" IsVisible="{Binding HasGpu}" Margin="13,0" />
                <UniformGrid Columns="2" RowSpacing="12" ColumnSpacing="12" IsVisible="{Binding HasGpu}">
                    <ContentControl Content="{Binding Gpu}" />
                    <ContentControl Content="{Binding GpuMemory}" />
                    <ContentControl Content="{Binding GpuEncoder}" />
                    <ContentControl Content="{Binding GpuDecoder}" />
                </UniformGrid>
                <Border Classes="surface" Padding="12">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="{l:L monitor.runningEncodes}" />
                        <TextBlock Classes="muted" FontSize="12" Text="{l:L monitor.nothingIsEncoding}" IsVisible="{Binding !HasEncodes}" />
                        <ItemsControl Classes="reveal" ItemsSource="{Binding Encodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RunningEncode">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,2">
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Details}" FontSize="12" Classes="muted" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
