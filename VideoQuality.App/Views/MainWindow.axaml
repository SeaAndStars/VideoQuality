<u:UrsaWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:VideoQuality.App.Localization"
        xmlns:vm="using:VideoQuality.App.ViewModels"
        xmlns:views="using:VideoQuality.App.Views"
        xmlns:u="https://irihi.tech/ursa"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:fic="using:FluentIcons.Common"
        x:Class="VideoQuality.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Icon="/Assets/app.ico"
        Width="1500" Height="950"
        MinWidth="1080" MinHeight="720"
        IsFullScreenButtonVisible="False"
        Title="{Binding WindowTitle}">

    <!-- Self-drawn title bar (Ursa): app mark and name left, the page or comparison centred. -->
    <u:UrsaWindow.LeftContent>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center"
                    IsHitTestVisible="False">
            <views:AppMark Width="18" Height="18" />
            <TextBlock Text="VideoQuality" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
    </u:UrsaWindow.LeftContent>
    <u:UrsaWindow.TitleBarContent>
        <TextBlock Text="{Binding TitleText}" Classes="muted" FontSize="12" IsHitTestVisible="False"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   MaxWidth="700" />
    </u:UrsaWindow.TitleBarContent>

    <!-- Content starts below the self-drawn title bar (offset measured in code-behind). -->
    <Grid x:Name="Root" ColumnDefinitions="Auto,*">
        <!-- Navigation rail: one entry per tool, Settings pinned at the bottom. -->
        <Border Classes="rail">
            <DockPanel>
                <Button DockPanel.Dock="Top" Classes="tool" HorizontalAlignment="Left" Margin="8,8,8,4"
                        Click="OnToggleRail" ToolTip.Tip="{l:L shell.collapseExpandTheNavigation}"
                        AutomationProperties.Name="{l:L shell.toggleNavigation}">
                    <ic:SymbolIcon Symbol="Navigation" />
                </Button>
                <u:NavMenu DockPanel.Dock="Bottom" x:Name="SettingsNav" Classes="rail"
                           IsHorizontalCollapsed="{Binding IsNavCollapsed}" ExpandWidth="200" CollapseWidth="56"
                           SelectionChanged="OnSettingsNavSelected">
                    <u:NavMenuItem Header="{Binding SettingsPage.Title}" Tag="settings"
                                   IsSelected="{Binding IsSettings, Mode=OneWay}">
                        <u:NavMenuItem.Icon><ic:SymbolIcon Symbol="Settings" /></u:NavMenuItem.Icon>
                    </u:NavMenuItem>
                </u:NavMenu>
                <u:NavMenu x:Name="PagesNav" Classes="rail" ItemsSource="{Binding Pages}"
                           SelectedItem="{Binding SelectedPage}"
                           IsHorizontalCollapsed="{Binding IsNavCollapsed}" ExpandWidth="200" CollapseWidth="56"
                           HeaderBinding="{Binding Title, x:DataType=vm:NavPage}"
                           IconBinding="{Binding Icon, x:DataType=vm:NavPage}">
                    <u:NavMenu.IconTemplate>
                        <DataTemplate x:DataType="fic:Symbol">
                            <ic:SymbolIcon Symbol="{Binding}" />
                        </DataTemplate>
                    </u:NavMenu.IconTemplate>
                </u:NavMenu>
            </DockPanel>
        </Border>

        <!-- Every page stays alive; only the selected one is shown, so switching never loses work. -->
        <Panel Grid.Column="1">
            <views:CompareView DataContext="{Binding Compare}" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsCompare}" />
            <views:FontSubsetView DataContext="{Binding FontSubset}" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsFontSubset}" />
            <views:ExtractView DataContext="{Binding Extract}" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsExtract}" />
            <views:MuxView DataContext="{Binding Mux}" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsMux}" />
            <views:PipelineView DataContext="{Binding Pipeline}" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsPipeline}" />
            <views:SettingsView DataContext="{Binding Settings}" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsSettings}" />
        </Panel>
    </Grid>
</u:UrsaWindow>
