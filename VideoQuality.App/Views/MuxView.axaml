<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:VideoQuality.App.Localization"
             xmlns:vm="using:VideoQuality.App.ViewModels"
             xmlns:conv="using:VideoQuality.App.Converters"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:controls="using:VideoQuality.App.Controls"
             x:Class="VideoQuality.App.Views.MuxView"
             x:DataType="vm:MuxViewModel">
    <Panel>
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Margin="12">
            <Border Classes="raised" Padding="16,12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Classes="pageicon"><ic:SymbolIcon Symbol="Merge" /></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="pagetitle" Text="{l:L mux.mux}" />
                        <TextBlock Classes="pagesub" Text="{l:L mux.combineVideoAudioSubtitles}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <u:IconButton Classes="tool" Content="{l:L mux.addFiles}" Click="OnAddFiles">
                            <u:IconButton.Icon><ic:SymbolIcon Symbol="Add" /></u:IconButton.Icon>
                        </u:IconButton>
                        <u:IconButton Classes="tool" Content="{l:L mux.addFonts}" Click="OnAddFonts">
                            <u:IconButton.Icon><ic:SymbolIcon Symbol="TextFont" /></u:IconButton.Icon>
                        </u:IconButton>
                        <u:IconButton Classes="tool" Content="{l:L common.clear}" Command="{Binding ClearAllCommand}">
                            <u:IconButton.Icon><ic:SymbolIcon Symbol="Dismiss" /></u:IconButton.Icon>
                        </u:IconButton>
                        <Button Classes="primary" Command="{Binding MuxCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="Merge" FontSize="16" />
                                <TextBlock Text="{l:L mux.mux}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <DockPanel Grid.Row="1">
                <u:Banner DockPanel.Dock="Top" Margin="0,0,0,12" Type="Warning" IsVisible="{Binding !Settings.HasMkvToolNix}"
                          Header="{l:L common.mkvtoolnixNotFound}"
                          Content="{l:L common.mkvtoolnixMissingHint}" />

                <Grid ColumnDefinitions="3*,2*" ColumnSpacing="12">
                    <!-- inputs and their tracks -->
                    <Border Classes="surface">
                        <Grid RowDefinitions="Auto,*" Margin="12,0,12,12">
                            <Grid Classes="cardheader" ColumnDefinitions="*,Auto">
                                <TextBlock Classes="label" Text="{l:L mux.inputsAndTracks}" />
                                <Grid Grid.Column="1" ColumnDefinitions="96,*,60,60" ColumnSpacing="8" Width="380" IsVisible="{Binding HasInputs}">
                                    <TextBlock Classes="label" Text="{l:L mux.language}" />
                                    <TextBlock Grid.Column="1" Classes="label" Text="{l:L mux.name}" />
                                    <TextBlock Grid.Column="2" Classes="label" Text="{l:L mux.default}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Classes="label" Text="{l:L mux.forced}" HorizontalAlignment="Center" />
                                </Grid>
                            </Grid>
                            <Panel Grid.Row="1">
                                <StackPanel IsVisible="{Binding !HasInputs}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                    <ic:SymbolIcon Symbol="DocumentArrowDown" FontSize="36" Foreground="{DynamicResource SemiColorText2}" />
                                    <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                                               Text="{l:L mux.dropTheEncodedVideo}" />
                                </StackPanel>
                                <ScrollViewer IsVisible="{Binding HasInputs}">
                                    <ItemsControl Classes="reveal" ItemsSource="{Binding Inputs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MuxInputRow">
                                                <Border Background="{DynamicResource SemiColorFill0}" CornerRadius="{StaticResource VqRadiusControl}" Padding="10,8" Margin="0,0,0,8">
                                                    <StackPanel Spacing="4">
                                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" ToolTip.Tip="{Binding Path}" />
                                                            <CheckBox Grid.Column="1" Content="{l:L mux.attachments}" IsChecked="{Binding KeepAttachments}" IsVisible="{Binding HasAttachments}" FontSize="12" />
                                                            <CheckBox Grid.Column="2" Content="{l:L mux.chapters2}" IsChecked="{Binding KeepChapters}" IsVisible="{Binding HasChapters}" FontSize="12" />
                                                            <Button Grid.Column="3" Classes="rowaction" ToolTip.Tip="{l:L mux.removeInput}"
                                                                    Command="{Binding $parent[UserControl].((vm:MuxViewModel)DataContext).RemoveInputCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <ic:SymbolIcon Symbol="Dismiss" />
                                                            </Button>
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding Tracks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:MuxTrackRow">
                                                                    <Grid ColumnDefinitions="Auto,Auto,*,380" ColumnSpacing="10" Margin="0,2">
                                                                        <CheckBox IsChecked="{Binding Include}" VerticalAlignment="Center" />
                                                                        <ic:SymbolIcon Grid.Column="1" Symbol="{Binding Icon}" FontSize="16" />
                                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Codec}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding Details}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <Grid Grid.Column="3" ColumnDefinitions="96,*,60,60" ColumnSpacing="8">
                                                                            <TextBox Text="{Binding Language}" Watermark="{l:L mux.und}" FontSize="12" />
                                                                            <TextBox Grid.Column="1" Text="{Binding Name}" Watermark="{l:L mux.trackName}" FontSize="12" />
                                                                            <CheckBox Grid.Column="2" IsChecked="{Binding Default}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            <CheckBox Grid.Column="3" IsChecked="{Binding Forced}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Panel>
                        </Grid>
                    </Border>

                    <!-- fonts and output -->
                    <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="12">
                        <Border Classes="surface">
                            <Grid RowDefinitions="Auto,*" Margin="12,0,12,12">
                                <Grid Classes="cardheader" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="label" Text="{l:L mux.fontsAttachments}" />
                                    <TextBlock Grid.Column="1" Text="{Binding AttachmentSummary}" Classes="muted" FontSize="12"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <ScrollViewer Grid.Row="1">
                                    <ItemsControl Classes="reveal" ItemsSource="{Binding Attachments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Classes="row">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                        <ic:SymbolIcon Symbol="TextFont" FontSize="16" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Converter={x:Static conv:PathConverters.FileName}}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" ToolTip.Tip="{Binding}" />
                                                        <Button Grid.Column="2" Classes="rowaction" ToolTip.Tip="{l:L common.remove}"
                                                                Command="{Binding $parent[UserControl].((vm:MuxViewModel)DataContext).RemoveAttachmentCommand}"
                                                                CommandParameter="{Binding}">
                                                            <ic:SymbolIcon Symbol="Dismiss" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Classes="surface">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="6" Margin="12,0,12,12">
                                <Grid Classes="cardheader" Grid.ColumnSpan="2"><TextBlock Classes="label" Text="{l:L common.output}" /></Grid>
                                <TextBlock Grid.Row="1" Classes="label" Text="{l:L mux.file}" />
                                <TextBox Grid.Row="2" Text="{Binding Output}" Watermark="{l:L mux.releaseMkv}" />
                                <Button Grid.Row="2" Grid.Column="1" Classes="tool" Click="OnPickOutput" ToolTip.Tip="{l:L common.chooseFile}">
                                    <ic:SymbolIcon Symbol="Save" />
                                </Button>
                                <TextBlock Grid.Row="3" Classes="label" Text="{l:L common.title}" Margin="0,4,0,0" />
                                <TextBox Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding Title}" Watermark="{l:L common.segmentTitleOptional}" />
                                <TextBlock Grid.Row="5" Classes="label" Text="{l:L mux.chapters}" Margin="0,4,0,0" />
                                <TextBox Grid.Row="6" Text="{Binding Chapters}" Watermark="{l:L mux.chaptersXmlOptional}" />
                                <Button Grid.Row="6" Grid.Column="1" Classes="tool" Click="OnPickChapters" ToolTip.Tip="{l:L mux.chooseChaptersFile}">
                                    <ic:SymbolIcon Symbol="FolderOpen" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </DockPanel>

            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,200" ColumnSpacing="8" Margin="4,0">
                <controls:Spinner IsVisible="{Binding IsBusy}" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="2" Minimum="0" Maximum="1" Value="{Binding Progress}" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
            </Grid>
        </Grid>
        <Border Classes="dropglow" />
    </Panel>
</UserControl>
