<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:VideoQuality.App.Localization"
             xmlns:vm="using:VideoQuality.App.ViewModels"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:conv="using:VideoQuality.App.Converters"
             x:Class="VideoQuality.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <UserControl.Resources>
        <conv:LabelConverter x:Key="Label" />
    </UserControl.Resources>
    <ScrollViewer Margin="12">
        <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Stretch">
            <Border Classes="raised" Padding="16,12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border Classes="pageicon"><ic:SymbolIcon Symbol="Settings" /></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="pagetitle" Text="{l:L common.settings}" />
                        <TextBlock Classes="pagesub" Text="{l:L settings.toolsScoringDefaultsAnd}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- language -->
            <Border Classes="surface">
                <Grid Classes="form" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="160,*" Margin="16,0,16,14">
                    <Grid Classes="cardheader" Grid.ColumnSpan="2"><TextBlock Classes="label" Text="{l:L settings.general}" /></Grid>
                    <TextBlock Grid.Row="1" Text="{l:L settings.language}" VerticalAlignment="Center" />
                    <ComboBox HorizontalAlignment="Left" Grid.Row="1" Grid.Column="1" MinWidth="260" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage, Converter={x:Static conv:KeepSelectionConverter.Instance}}"
                              DisplayMemberBinding="{Binding Name, x:DataType=vm:LanguageOption}" />
                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding NeedsRestart}">
                        <ic:SymbolIcon Symbol="ArrowClockwise" FontSize="16" Foreground="{DynamicResource SemiColorPrimary}" />
                        <TextBlock Grid.Column="1" Text="{l:L settings.language.restartHint}" Classes="muted" FontSize="12"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="primary" Command="{Binding RestartCommand}" Content="{l:L settings.language.restart}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- scoring -->
            <Border Classes="surface">
                <Grid Classes="form" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="160,*" Margin="16,0,16,14">
                    <Grid Classes="cardheader" Grid.ColumnSpan="2"><TextBlock Classes="label" Text="{l:L common.scoring}" /></Grid>
                    <TextBlock Grid.Row="1" Text="{l:L settings.vmafModel}" VerticalAlignment="Center" />
                    <ComboBox HorizontalAlignment="Left" Grid.Row="1" Grid.Column="1" MinWidth="260" ItemsSource="{Binding Compare.ModelOptions}" SelectedItem="{Binding Compare.SelectedModel, Converter={x:Static conv:KeepSelectionConverter.Instance}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Converter={StaticResource Label}}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Row="2" Text="{l:L common.backend}" VerticalAlignment="Center" />
                    <ComboBox HorizontalAlignment="Left" Grid.Row="2" Grid.Column="1" MinWidth="260" ItemsSource="{Binding Compare.BackendOptions}" SelectedItem="{Binding Compare.SelectedBackend, Converter={x:Static conv:KeepSelectionConverter.Instance}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Converter={StaticResource Label}}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- tools -->
            <Border Classes="surface">
                <Grid Classes="form" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="160,*,Auto,Auto" Margin="16,0,16,14">
                    <Grid Classes="cardheader" Grid.ColumnSpan="4"><TextBlock Classes="label" Text="{l:L settings.tools}" /></Grid>
                    <TextBlock Grid.Row="1" Text="{l:L settings.ffmpeg}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Compare.FfmpegPath}" IsReadOnly="True" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Compare.BackendStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="3" Text="{l:L settings.mkvtoolnixFolder}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MkvToolNixFolder}" Watermark="{l:L settings.mkvtoolnixAuto}" />
                    <Button Grid.Row="3" Grid.Column="2" Classes="tool" Click="OnPickMkvToolNix" ToolTip.Tip="{l:L common.chooseFolder}">
                        <ic:SymbolIcon Symbol="FolderOpen" />
                    </Button>
                    <u:IconButton Grid.Row="3" Grid.Column="3" Classes="tool" Content="{l:L settings.locate}" Command="{Binding LocateToolsCommand}">
                        <u:IconButton.Icon><ic:SymbolIcon Symbol="Search" /></u:IconButton.Icon>
                    </u:IconButton>
                    <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="CheckmarkCircle" IconVariant="Filled" FontSize="16" Foreground="{DynamicResource SemiColorSuccess}" IsVisible="{Binding HasMkvToolNix}" />
                        <ic:SymbolIcon Symbol="Warning" IconVariant="Filled" FontSize="16" Foreground="{DynamicResource SemiColorWarning}" IsVisible="{Binding !HasMkvToolNix}" />
                        <TextBlock Text="{Binding MkvToolNixStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Row="5" Text="{l:L settings.encoderFfmpegFolder}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding EncoderFolder}" Watermark="{l:L settings.automaticTheBundledGpl}" />
                    <Button Grid.Row="5" Grid.Column="2" Classes="tool" Click="OnPickEncoder" ToolTip.Tip="{l:L common.chooseFolder}">
                        <ic:SymbolIcon Symbol="FolderOpen" />
                    </Button>
                    <u:IconButton Grid.Row="5" Grid.Column="3" Classes="tool" Content="{l:L settings.locate}" Command="{Binding LocateToolsCommand}">
                        <u:IconButton.Icon><ic:SymbolIcon Symbol="Search" /></u:IconButton.Icon>
                    </u:IconButton>
                    <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="CheckmarkCircle" IconVariant="Filled" FontSize="16" Foreground="{DynamicResource SemiColorSuccess}" IsVisible="{Binding HasEncoder}" />
                        <ic:SymbolIcon Symbol="Warning" IconVariant="Filled" FontSize="16" Foreground="{DynamicResource SemiColorWarning}" IsVisible="{Binding !HasEncoder}" />
                        <TextBlock Text="{Binding EncoderStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="560" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- workflow -->
            <Border Classes="surface">
                <Grid Classes="form" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="160,*" Margin="16,0,16,14">
                    <Grid Classes="cardheader" Grid.ColumnSpan="2"><TextBlock Classes="label" Text="{l:L settings.workflow}" /></Grid>
                    <TextBlock Grid.Row="1" Text="{l:L settings.trackNaming}" VerticalAlignment="Center" />
                    <ComboBox HorizontalAlignment="Left" Grid.Row="1" Grid.Column="1" MinWidth="260" ItemsSource="{Binding TrackNamingOptions}" SelectedItem="{Binding TrackNaming, Converter={x:Static conv:KeepSelectionConverter.Instance}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Converter={StaticResource Label}}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Row="2" Text="{l:L settings.encodesAtOnce}" VerticalAlignment="Center" />
                    <ComboBox HorizontalAlignment="Left" Grid.Row="2" Grid.Column="1" MinWidth="120" ItemsSource="{Binding ConcurrencyOptions}" SelectedItem="{Binding EncodeConcurrency, Converter={x:Static conv:KeepSelectionConverter.Instance}}"
                              ToolTip.Tip="{l:L settings.x265AlreadyUsesEvery}" />
                </Grid>
            </Border>

            <!-- files -->
            <Border Classes="surface">
                <Grid Classes="form" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="160,*,Auto" Margin="16,0,16,14">
                    <Grid Classes="cardheader" Grid.ColumnSpan="3"><TextBlock Classes="label" Text="{l:L settings.files}" /></Grid>
                    <TextBlock Grid.Row="1" Text="{l:L common.settings}" VerticalAlignment="Center" />
                    <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SettingsPath}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Text="{l:L settings.appFolder}" VerticalAlignment="Center" />
                    <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AppFolder}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Row="2" Grid.Column="2" Classes="rowaction" Click="OnOpenAppFolder" ToolTip.Tip="{l:L common.openFolder}">
                        <ic:SymbolIcon Symbol="Open" />
                    </Button>
                    <TextBlock Grid.Row="3" Text="{l:L settings.lastLog}" VerticalAlignment="Center" />
                    <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Compare.LogPath}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- about -->
            <Border Classes="surface">
                <Grid Classes="form" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="160,*" Margin="16,0,16,14">
                    <Grid Classes="cardheader" Grid.ColumnSpan="2"><TextBlock Classes="label" Text="{l:L settings.about}" /></Grid>
                    <TextBlock Grid.Row="1" Text="VideoQuality" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Version}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Text="{l:L settings.harfbuzz}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HarfBuzzVersion}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="{l:L settings.aboutLicense}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
