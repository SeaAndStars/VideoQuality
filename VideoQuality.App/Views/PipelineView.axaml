<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:VideoQuality.App.Localization"
             xmlns:vm="using:VideoQuality.App.ViewModels"
             xmlns:conv="using:VideoQuality.App.Converters"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:controls="using:VideoQuality.App.Controls"
             x:Class="VideoQuality.App.Views.PipelineView"
             x:DataType="vm:PipelineViewModel">
    <UserControl.Resources>
        <conv:LabelConverter x:Key="Label" />
    </UserControl.Resources>
    <Panel>
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" Margin="12">
            <Border Classes="raised" Padding="16,12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Classes="pageicon"><ic:SymbolIcon Symbol="FlowchartCircle" /></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="pagetitle" Text="{l:L pipeline.releasePipeline}" />
                        <TextBlock Classes="pagesub" Text="{l:L pipeline.sourceToReleaseIn}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <u:IconButton Classes="tool" Content="{l:L common.clear}" Command="{Binding ClearCommand}">
                            <u:IconButton.Icon><ic:SymbolIcon Symbol="Dismiss" /></u:IconButton.Icon>
                        </u:IconButton>
                        <u:IconButton Classes="tool" Content="{l:L pipeline.openInCompare}" Command="{Binding OpenInCompareCommand}">
                            <u:IconButton.Icon><ic:SymbolIcon Symbol="DataLine" /></u:IconButton.Icon>
                        </u:IconButton>
                        <Button Classes="primary" Command="{Binding RunCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="Play" FontSize="16" />
                                <TextBlock Text="{l:L pipeline.run}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <u:Banner Grid.Row="1" Type="Warning" IsVisible="{Binding !Settings.HasEncoder}"
                      Header="{l:L pipeline.encoderFfmpegNotFound}" Content="{l:L pipeline.theEncodeAndBurn}" />

            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Classes="surface">
                    <ScrollViewer>
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="130,*,Auto"
                              RowSpacing="8" ColumnSpacing="8" Margin="12,0,12,12">
                            <Grid Classes="cardheader" Grid.ColumnSpan="3"><TextBlock Classes="label" Text="{l:L pipeline.inputs}" /></Grid>

                            <TextBlock Grid.Row="1" Text="{l:L pipeline.sourceVideo}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Video}" Watermark="{l:L pipeline.theWebripBdSource}" />
                            <Button Grid.Row="1" Grid.Column="2" Classes="tool" Click="OnPickVideo" ToolTip.Tip="{l:L pipeline.chooseVideo}">
                                <ic:SymbolIcon Symbol="FolderOpen" />
                            </Button>
                            <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Content="{l:L pipeline.alreadyEncodedSkipEncoding}" IsChecked="{Binding AlreadyEncoded}" />
                            <TextBlock Grid.Row="3" Text="{l:L compare.reference2}" VerticalAlignment="Center" IsVisible="{Binding AlreadyEncoded}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Reference}" Watermark="{l:L pipeline.sourceForVmafOptional}" IsVisible="{Binding AlreadyEncoded}" />
                            <Button Grid.Row="3" Grid.Column="2" Classes="tool" Click="OnPickReference" ToolTip.Tip="{l:L pipeline.chooseVideo}" IsVisible="{Binding AlreadyEncoded}">
                                <ic:SymbolIcon Symbol="FolderOpen" />
                            </Button>

                            <TextBlock Grid.Row="4" Text="{l:L pipeline.scripts}" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <Border Grid.Row="4" Grid.Column="1" Background="{DynamicResource SemiColorFill0}" CornerRadius="{StaticResource VqRadiusControl}" MinHeight="44" Padding="4">
                                <Panel>
                                    <TextBlock Classes="muted" FontSize="12" Text="{l:L pipeline.dropTheAssScripts}" Margin="6,0"
                                               VerticalAlignment="Center" IsVisible="{Binding !Scripts.Count}" />
                                    <ItemsControl ItemsSource="{Binding Scripts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Classes="row">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                        <ic:SymbolIcon Symbol="Subtitles" FontSize="16" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Converter={x:Static conv:PathConverters.FileName}}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" ToolTip.Tip="{Binding}" />
                                                        <Button Grid.Column="2" Classes="rowaction" ToolTip.Tip="{l:L common.remove}"
                                                                Command="{Binding $parent[UserControl].((vm:PipelineViewModel)DataContext).RemoveScriptCommand}" CommandParameter="{Binding}">
                                                            <ic:SymbolIcon Symbol="Dismiss" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Panel>
                            </Border>
                            <Button Grid.Row="4" Grid.Column="2" Classes="tool" Click="OnAddScripts" ToolTip.Tip="{l:L common.addScripts}" VerticalAlignment="Top">
                                <ic:SymbolIcon Symbol="Add" />
                            </Button>

                            <TextBlock Grid.Row="5" Text="{l:L pipeline.fontFolder}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding FontDirectory}" Watermark="{l:L pipeline.folderWithTheFonts}" />
                            <Button Grid.Row="5" Grid.Column="2" Classes="tool" Click="OnPickFonts" ToolTip.Tip="{l:L common.chooseFolder}">
                                <ic:SymbolIcon Symbol="FolderOpen" />
                            </Button>

                            <TextBlock Grid.Row="6" Text="{l:L nav.chapters}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ChaptersFile}" Watermark="{l:L pipeline.theSourceSChapters}" />
                            <Button Grid.Row="6" Grid.Column="2" Classes="tool" Click="OnPickChapters" ToolTip.Tip="{l:L mux.chooseChaptersFile}">
                                <ic:SymbolIcon Symbol="FolderOpen" />
                            </Button>

                            <Grid Classes="cardheader" Grid.Row="7" Grid.ColumnSpan="3"><TextBlock Classes="label" Text="{l:L naming.release}" /></Grid>
                            <TextBlock Grid.Row="8" Text="{l:L pipeline.releaseKind}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" ItemsSource="{Binding Profiles}"
                                      SelectedItem="{Binding Profile, Converter={x:Static conv:KeepSelectionConverter.Instance}}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource Label}}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="9" Text="{l:L pipeline.crfX26510Bit}" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Value="{Binding Crf}" Minimum="0" Maximum="51" Increment="0.5" FormatString="0.#" HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="10" Text="{l:L pipeline.alsoMake}" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16">
                                <CheckBox Content="{l:L pipeline.burnedInMp4s}" IsChecked="{Binding MakeBurned}" />
                                <CheckBox Content="{l:L pipeline.step.vmaf}" IsChecked="{Binding RunVmaf}" />
                            </StackPanel>
                            <TextBlock Grid.Row="11" Text="{l:L picker.outputFolder}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding OutputDirectory}" />
                            <Button Grid.Row="11" Grid.Column="2" Classes="tool" Click="OnPickOutput" ToolTip.Tip="{l:L common.chooseFolder}">
                                <ic:SymbolIcon Symbol="FolderOpen" />
                            </Button>
                            <TextBlock Grid.Row="12" Text="{l:L pipeline.fileNames}" VerticalAlignment="Top" />
                            <ItemsControl Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding OutputNames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2" Classes="muted" FontSize="11" TextWrapping="Wrap"
                                       Text="{l:L pipeline.titleEpisodeAndSource}" />
                        </Grid>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="1" Classes="surface">
                    <Grid RowDefinitions="Auto,*" Margin="12,0,12,12">
                        <Grid Classes="cardheader"><TextBlock Classes="label" Text="{l:L pipeline.steps}" /></Grid>
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PipelineStep">
                                        <Border Background="{DynamicResource SemiColorFill0}" CornerRadius="{StaticResource VqRadiusControl}" Padding="12,10" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                                                <Panel Width="24" Height="24" VerticalAlignment="Top" Margin="0,2,0,0">
                                                    <ic:SymbolIcon Symbol="Clock" FontSize="20" Foreground="{DynamicResource SemiColorText2}" IsVisible="{Binding IsPending}" />
                                                    <controls:Spinner IsVisible="{Binding IsRunning}" />
                                                    <ic:SymbolIcon Symbol="CheckmarkCircle" IconVariant="Filled" FontSize="22" Foreground="{DynamicResource SemiColorSuccess}" IsVisible="{Binding IsDone}" />
                                                    <ic:SymbolIcon Symbol="ErrorCircle" IconVariant="Filled" FontSize="22" Foreground="{DynamicResource SemiColorDanger}" IsVisible="{Binding IsFailed}" />
                                                    <ic:SymbolIcon Symbol="ArrowForward" FontSize="20" Foreground="{DynamicResource SemiColorText3}" IsVisible="{Binding IsSkipped}" />
                                                </Panel>
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                                    <SelectableTextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                                               IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" IsVisible="{Binding IsRunning}" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="4,0">
                <controls:Spinner IsVisible="{Binding IsBusy}" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </Grid>
        <Border Classes="dropglow" />
    </Panel>
</UserControl>
