<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VideoQuality.App.App"
             xmlns:semi="https://irihi.tech/semi"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- Semi supplies the base controls; Ursa's Semi theme styles the Ursa controls on top. -->
        <semi:SemiTheme Locale="en-US" />
        <semi:UrsaSemiTheme Locale="en-US" />
        <StyleInclude Source="/Styles/Layers.axaml" />
    </Application.Styles>
</Application>
